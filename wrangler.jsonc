{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "garage-brain",
  "main": "src/server.ts",
  "compatibility_date": "2026-04-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/agents/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      { "class_name": "GarageAgent", "name": "GarageAgent" },
      { "class_name": "VehicleAgent", "name": "VehicleAgent" },
      { "class_name": "ToolboxAgent", "name": "ToolboxAgent" }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["GarageAgent"],
      "tag": "v1"
    },
    {
      "new_sqlite_classes": ["VehicleAgent", "ToolboxAgent"],
      "tag": "v2"
    }
  ]
}
