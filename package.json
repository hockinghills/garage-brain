{
  "name": "garage-brain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "wrangler pages dev dist",
    "deploy": "wrangler pages deploy dist",
    "db:migrate": "wrangler d1 execute garage-brain-db --file=./db/schema.sql",
    "db:migrate:local": "wrangler d1 execute garage-brain-db --local --file=./db/schema.sql"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250410.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.3.1",
    "wrangler": "^4.6.0"
  }
}
